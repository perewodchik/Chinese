[
 {
  "id": "wfj-arrive",
  "map": "wangfujing-street",
  "trigger": "auto",
  "once": true,
  "stamp": "wangfujing",
  "start": "a",
  "nodes": [
   {
    "id": "a",
    "say": "王府井今天人山人海！",
    "translate": "Wangfujing is a sea of people today!",
    "speaker": "companion",
    "key": true,
    "onEnter": [
     {
      "do": "idiom",
      "idiom": "人山人海"
     }
    ],
    "why": "A 成语 📌: 人山人海 — mountains of people, seas of people. You can guess it from its four characters."
   }
  ]
 },
 {
  "id": "bank",
  "map": "yinhang",
  "npc": "yinhang-yuan",
  "trigger": "talk",
  "once": true,
  "priority": 0,
  "stamp": "huanqian",
  "start": "a",
  "words": [
   {
    "w": "换钱",
    "explain": "用一个国家的钱，换别的国家的钱。",
    "en": "change money"
   },
   {
    "w": "护照",
    "explain": "去别的国家用的小本子。",
    "en": "passport"
   },
   {
    "w": "美元",
    "explain": "美国的钱。",
    "en": "US dollars"
   },
   {
    "w": "签字",
    "explain": "写你的名字。",
    "en": "sign"
   }
  ],
  "nodes": [
   {
    "id": "a",
    "say": "你好！你要做什么？",
    "translate": "Hello! What can I do for you?",
    "expect": [
     {
      "intent": "change",
      "match": [
       [
        "换钱",
        "换"
       ]
      ],
      "go": "b"
     }
    ],
    "hint": {
     "word": "换钱",
     "frame": "我要___。",
     "full": "我要换钱。"
    }
   },
   {
    "id": "b",
    "say": "换钱？好的。请给我你的护照。",
    "translate": "Change money? Certainly. Your passport, please.",
    "expect": [
     {
      "intent": "give",
      "match": [
       [
        "给",
        "好",
        "这是",
        "护照"
       ]
      ],
      "go": "c"
     }
    ],
    "hint": {
     "word": "护照",
     "frame": "好，这是我的___。",
     "full": "好，这是我的护照。"
    }
   },
   {
    "id": "c",
    "say": "你有多少美元？",
    "translate": "How many dollars have you got?",
    "expect": [
     {
      "intent": "amount",
      "match": [
       [
        "一百",
        "100",
        "一百块"
       ]
      ],
      "go": "d"
     }
    ],
    "hint": {
     "word": "一百",
     "frame": "我有___美元。",
     "full": "我有一百美元。"
    },
    "why": "Only a hundred to change today."
   },
   {
    "id": "d",
    "say": "一百美元，七百块钱。请在这儿签字。",
    "translate": "A hundred dollars — seven hundred yuan. Please sign here.",
    "simpler": "请签字。",
    "expect": [
     {
      "intent": "sign",
      "match": [
       [
        "好",
        "签",
        "签字",
        "行"
       ]
      ],
      "go": "e",
      "actions": [
       {
        "do": "money",
        "amount": 700
       },
       {
        "do": "flag",
        "flag": "changed-money"
       }
      ]
     }
    ],
    "hint": {
     "word": "好",
     "frame": "___。",
     "full": "好。"
    }
   },
   {
    "id": "e",
    "say": "好了。这是你的钱和护照。",
    "translate": "Done. Here's your money and your passport — and your 美元 receipt.",
    "simpler": "这是你的护照。"
   }
  ]
 },
