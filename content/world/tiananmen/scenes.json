 {
  "id": "dragon",
  "map": "jiulongbi",
  "object": "screen",
  "trigger": "look",
  "priority": 0,
  "stamp": "long",
  "when": {
   "all": [
    {
     "chapter": 7
    },
    {
     "not": {
      "spirit": "long"
     }
    }
   ]
  },
  "start": "a",
  "words": [
   {
    "w": "点睛",
    "explain": "画上眼睛。",
    "en": "to dot in the eyes"
   },
   {
    "w": "神",
    "explain": "天上的人，人看不见。",
    "en": "spirit"
   }
  ],
  "nodes": [
   {
    "id": "a",
    "say": "你看！这个龙没有眼睛。",
    "translate": "Look! This dragon has no eyes.",
    "speaker": "companion",
    "next": "b"
   },
   {
    "id": "b",
    "say": "朋友，我们来了！",
    "translate": "Friend — we're here!",
    "speaker": "shishizi",
    "next": "c",
    "why": "Every spirit you have befriended comes to help: the stone lion, the fox, the door gods, the qilin, the pixiu, the Nian beast."
   },
   {
    "id": "c",
    "say": "我们帮你！",
    "translate": "We'll help you!",
    "speaker": "jiuweihu",
    "next": "d"
   },
   {
    "id": "d",
    "say": "画龙要点睛。你来吧！",
    "translate": "A painted dragon needs its eyes dotted in. You do it!",
    "speaker": "companion",
    "expect": [
     {
      "intent": "dot",
      "match": [
       [
        "点睛",
        "点",
        "眼睛",
        "画",
        "睛"
       ]
      ],
      "go": "e"
     }
    ],
    "hint": {
     "word": "点睛",
     "frame": "我来___！",
     "full": "我来点睛！"
    }
   },
   {
    "id": "e",
    "say": "画龙点睛！",
    "translate": "画龙点睛 — the eyes are dotted!",
    "speaker": "companion",
    "key": true,
    "next": "f",
    "onEnter": [
     {
      "do": "idiom",
      "idiom": "画龙点睛"
     }
    ],
    "why": "A 成语 📌 with a story: a painter dotted in the eyes of the dragons he had painted, and they flew away. The finishing touch that brings a thing to life."
   },
   {
    "id": "f",
    "say": "谢谢你们！我是龙。我们都是朋友了！",
    "translate": "Thank you, all of you! I am the dragon. We're all friends now!",
    "speaker": "long",
    "onEnter": [
     {
      "do": "spirit",
      "spirit": "long"
     }
    ],
    "next": "g"
   },
   {
    "id": "g",
    "say": "小神都找到了！他们都回来了！",
    "translate": "We found them all! Every spirit has come back!",
    "speaker": "companion",
    "simpler": "小神都找到了！"
   }
  ]
 },
