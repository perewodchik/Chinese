  {
    "id": "arrive",
    "map": "siheyuan-yard",
    "npc": "wang-ayi",
    "trigger": "talk",
    "once": true,
    "priority": 0,
    "stamp": "new-home",
    "start": "hi",
    "nodes": [
      {
        "id": "hi",
        "say": "你好！你是新来的吧？我是王阿姨。",
        "translate": "Hello! You must be the new one? I'm Auntie Wang.",
        "simpler": "你好！我是王阿姨。",
        "why": "吧 at the end makes a guess: 'you're the new one, right?'. 阿姨 is how you address a woman of your parents' age.",
        "expect": [
          {
            "intent": "greet",
            "match": [
              [
                "你好",
                "您好",
                "阿姨好",
                "王阿姨",
                "是",
                "对"
              ]
            ],
            "go": "name"
          }
        ],
        "hint": {
          "word": "你好",
          "frame": "___，王阿姨！",
          "full": "你好，王阿姨！"
        }
      },
      {
        "id": "name",
        "say": "你叫什么名字？",
        "translate": "What's your name?",
        "expect": [
          {
            "intent": "name",
            "match": [
              [
                "叫",
                "名字",
                "是"
              ]
            ],
            "go": "room",
            "actions": [
              {
                "do": "remember",
                "npc": "wang-ayi",
                "note": "told her their name"
              }
            ]
          }
        ],
        "hint": {
          "word": "我叫",
          "frame": "我叫___。",
          "full": "我叫大卫。"
        },
        "why": "叫 is 'to be called'. Answer with 我叫 + your name."
      },
      {
        "id": "room",
        "say": "好！你的房间在那儿。你吃早饭了吗？",
        "translate": "Good! Your room is over there. Have you had breakfast?",
        "simpler": "你吃早饭了吗？",
        "expect": [
          {
            "intent": "not-yet",
            "match": [
              [
                "没",
                "没有",
                "还没"
              ]
            ],
            "go": "eat"
          },
          {
            "intent": "ate",
            "match": [
              [
                "吃了",
                "吃过"
              ]
            ],
            "go": "ate"
          }
        ],
        "hint": {
          "word": "没有",
          "frame": "___，我还没吃。",
          "full": "没有，我还没吃。"
        },
        "why": "吃了吗 — 'have you eaten?' — is also just a friendly hello in Beijing."
      },
      {
        "id": "eat",
        "say": "南锣鼓巷有一个早点铺，包子很好吃！去吃吧。",
        "translate": "On 南锣鼓巷 there's a breakfast shop, the buns are great! Go and eat.",
        "simpler": "去早点铺吃包子吧！",
        "why": "吧 here is a friendly push: 'go on, eat!'. 南锣鼓巷 is east of our lane."
      },
      {
        "id": "ate",
        "say": "好！那去南锣鼓巷看看吧。早点铺的包子很好吃！",
        "translate": "Good! Then go and look around 南锣鼓巷. The buns at the breakfast shop are great!",
        "simpler": "去南锣鼓巷看看吧！"
      }
