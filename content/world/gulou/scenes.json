            "go": "f"
          }
        ],
        "hint": {
          "word": "好",
          "frame": "___，我们去吧！",
          "full": "好，我们去吧！"
        }
      },
      {
        "id": "f",
        "say": "你问问人吧。他们看见了什么？",
        "translate": "Ask people. What have they seen?",
        "speaker": "companion"
      }
