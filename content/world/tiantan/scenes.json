  "trigger": "auto",
  "once": true,
  "stamp": "tiantan",
  "start": "a",
  "nodes": [
   {
    "id": "a",
    "say": "这是天坛！",
    "translate": "So this is the Temple of Heaven!",
    "speaker": "hero",
    "why": "天坛 — where emperors prayed for good harvests. The round blue hall is 祈年殿; the Echo Wall 回音壁 is further east."
   }
  ]
 },
 {
  "id": "erhu",
  "map": "tiantan-park",
  "npc": "huqin-yeye",
  "trigger": "talk",
  "start": "a",
  "nodes": [
   {
    "id": "a",
    "say": "你听！我的歌好听吗？",
    "translate": "Listen! Is my song nice?",
    "expect": [
     {
      "intent": "nice",
      "match": [
       [
        "好听",
        "好",
        "很好",
        "喜欢",
        "不错"
       ]
      ],
      "go": "b"
     }
    ],
    "hint": {
     "word": "好听",
     "frame": "很___！",
     "full": "很好听！"
    }
   },
   {
    "id": "b",
    "say": "谢谢！他们都不听，我是对牛弹琴！",
    "translate": "Thank you! They never listen — I'm playing the zither to cows!",
    "key": true,
    "onEnter": [
     {
      "do": "idiom",
      "idiom": "对牛弹琴"
     }
    ],
    "why": "A 成语 📌: 对牛弹琴 — playing the zither to a cow: talking to people who won't listen. He is joking about his chatting friends."
   }
  ],
  "priority": 5
 },
 {
