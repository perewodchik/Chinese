   ]
  },
  "start": "a",
  "words": [
   {
    "w": "老虎",
    "explain": "很大的猫，很大很大，大家都怕它。",
    "en": "tiger"
   },
   {
    "w": "怕",
    "explain": "看见不好的东西，想跑。",
    "en": "to be afraid"
   }
  ],
  "nodes": [
   {
    "id": "a",
    "say": "你是谁？你也怕我吧？老虎都怕我！",
    "translate": "Who are you? You're scared of me too, aren't you? Even tigers are scared of me!",
    "speaker": "jiuweihu",
    "simpler": "老虎怕我！你也怕我吗？",
    "expect": [
     {
      "intent": "brave",
      "match": [
       [
        "不怕",
        "不",
        "朋友",
        "兔儿爷",
        "我是"
       ]
      ],
      "go": "b"
     }
    ],
    "hint": {
     "word": "不怕",
     "frame": "我___你。",
     "full": "我不怕你。"
    }
   },
   {
    "id": "b",
    "say": "它这是狐假虎威。",
    "translate": "That's 狐假虎威 — the fox borrowing the tiger's might.",
    "speaker": "companion",
    "key": true,
    "next": "c",
    "onEnter": [
     {
      "do": "idiom",
      "idiom": "狐假虎威"
     },
     {
      "do": "solve",
      "riddle": "singer/key"
     },
     {
      "do": "solve",
      "riddle": "fisher-fox/b"
     }
    ],
    "why": "A 成语 📌 with a story: the fox walked in front of the tiger, the animals fled from the tiger, and the fox said they feared *him*. Look it up in your 成语 book."
   },
   {
    "id": "c",
    "say": "好吧……你知道我叫什么吗？",
    "translate": "Fine… do you know my name?",
    "speaker": "jiuweihu",
    "expect": [
     {
      "intent": "name",
      "match": [
       [
        "九尾狐"
       ]
      ],
      "go": "d"
     }
    ],
    "hint": {
     "word": "九尾狐",
     "frame": "你是___！",
     "full": "你是九尾狐！"
    },
    "why": "Say its name: 九尾狐 — 九 nine, 尾 tail, 狐 fox. Tones: jiǔ wěi hú."
   },
   {
    "id": "d",
