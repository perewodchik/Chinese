        "hint": {
          "word": "看见",
          "frame": "你___什么了？",
          "full": "你看见什么了？"
        }
      },
      {
        "id": "b",
        "say": "我朋友说，国贸的银行里，有一个金色的东西，会动！",
        "translate": "A friend says in a bank at 国贸 there's something golden — and it moves!",
        "simpler": "银行里有一个金色的东西。",
        "next": "c"
      },
      {
        "id": "c",
        "say": "我半信半疑。",
        "translate": "I half believe it.",
        "key": true,
        "onEnter": [
          {
            "do": "flag",
            "flag": "heard-pixiu"
          },
          {
            "do": "idiom",
            "idiom": "半信半疑"
          }
        ],
        "why": "A 成语 📌: 半信半疑 — half believing, half doubting. You can read it from its parts."
      }
    ]
  },
