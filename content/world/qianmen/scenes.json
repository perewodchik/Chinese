 {
  "id": "opera",
  "map": "xiyuan",
  "npc": "jingju-yanyuan",
  "trigger": "talk",
  "priority": 0,
  "stamp": "jingju",
  "start": "a",
  "words": [
   {
    "w": "京剧",
    "explain": "北京的老戏，有歌，有脸谱。",
    "en": "Beijing opera"
   },
   {
    "w": "脸谱",
    "explain": "京剧里脸上画的颜色。",
    "en": "opera face paint"
   },
   {
    "w": "红脸",
    "explain": "红色的脸谱，是好人。",
    "en": "red face"
   },
   {
    "w": "白脸",
    "explain": "白色的脸谱，是坏人。",
    "en": "white face"
   }
  ],
  "nodes": [
   {
    "id": "a",
    "say": "你好！你喜欢京剧吗？",
    "translate": "Hello! Do you like Beijing opera?",
    "simpler": "你看过京剧的脸谱吗？",
    "expect": [
     {
      "intent": "any",
      "match": [
       [
        "喜欢",
        "不知道",
        "好",
        "是",
        "没",
        "不"
       ]
      ],
      "go": "b"
     }
    ],
    "hint": {
     "word": "喜欢",
     "frame": "我很___！",
     "full": "我很喜欢！"
    }
   },
   {
    "id": "b",
    "say": "你看这些脸谱。红脸是好人，白脸是坏人。",
    "translate": "Look at these masks. A red face is a good man, a white face a bad one.",
    "simpler": "红脸好，白脸坏。",
    "next": "c",
    "why": "In 京剧 the face paint tells you the character: red loyal and brave, white cunning, black honest and fierce."
   },
   {
    "id": "c",
    "say": "大栅栏东边有一个门。",
    "translate": "At the east end of 大栅栏 there's an old gate.",
    "next": "d"
   },
   {
    "id": "d",
    "say": "门神的颜色都没了。你去看看吧。",
    "translate": "The door gods on it have lost all their colour. Go and have a look.",
    "onEnter": [
     {
      "do": "flag",
      "flag": "heard-menshen"
     }
    ]
   }
  ]
 },
