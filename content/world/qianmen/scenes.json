   }
  ]
 },
 {
  "id": "menshen-give",
  "map": "qianmen-street",
  "object": "door-gods",
  "trigger": "look",
  "priority": 0,
  "stamp": "menshen",
  "when": {
   "all": [
    {
     "item": "hongzhi"
    },
    {
     "not": {
      "spirit": "menshen"
     }
    }
   ]
  },
  "start": "a",
  "words": [
   {
    "w": "红纸",
    "explain": "红色的纸。",
    "en": "red paper"
   }
  ],
  "nodes": [
   {
    "id": "a",
    "say": "你有红纸？给我们吧！",
    "translate": "You've got red paper? Give it to us!",
    "speaker": "menshen",
    "simpler": "红纸给我们吧！",
    "expect": [
     {
      "intent": "give",
      "match": [
       [
        "给",
        "好",
        "这是",
        "红纸",
        "行"
       ]
      ],
      "go": "b",
      "actions": [
       {
        "do": "take",
        "item": "hongzhi"
       },
       {
        "do": "spirit",
        "spirit": "menshen"
       }
      ]
     }
    ],
    "hint": {
     "word": "给",
     "frame": "好，___你们。",
     "full": "好，给你们。"
    }
   },
   {
    "id": "b",
    "say": "你看，我们好看了！好看吗？",
    "translate": "Look — we're beautiful again! Aren't we?",
    "speaker": "menshen",
    "expect": [
     {
      "intent": "more",
      "match": [
       [
        "好看",
        "漂亮",
        "很好",
        "再画",
        "画"
       ]
      ],
      "go": "c"
     }
    ],
    "hint": {
     "word": "好看",
     "frame": "很___！我再画一点？",
     "full": "很好看！我再画一点？"
    }
   },
   {
    "id": "c",
    "say": "别画了！再画是画蛇添足。",
    "translate": "Stop painting! Any more would be 画蛇添足 — drawing feet on a snake.",
    "speaker": "menshen",
    "key": true,
    "onEnter": [
     {
      "do": "idiom",
      "idiom": "画蛇添足"
     }
    ],
    "why": "A 成语 📌 with a story: a man who finished drawing his snake first added feet to it, and lost the prize. Adding more spoils it."
   }
  ]
 },
