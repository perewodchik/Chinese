  "nodes": [
   {
    "id": "a",
    "say": "这是前门！",
    "translate": "So this is Qianmen!",
    "speaker": "hero",
    "why": "前门 — the Front Gate — stood at the south of the old inner city. 大栅栏, just east, is a lane of shops hundreds of years old."
   }
