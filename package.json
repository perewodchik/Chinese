{
  "name": "hanzi-workshop",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Build and print Chinese character worksheets, review them until they stick, and read passages written from what you know — in one account, on every device.",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false server/src/dev.ts",
    "build": "tsc -b && vite build && node scripts/build-server.mjs && node scripts/build-api.mjs",
    "start": "node --disable-warning=ExperimentalWarning dist-server/server.mjs",
    "serve": "vite build && node scripts/build-server.mjs && npm start",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test \"server/test/**/*.test.ts\" \"src/**/*.test.ts\"",
    "typecheck": "tsc -b",
    "admin": "node --disable-warning=ExperimentalWarning --import tsx server/src/cli.ts",
    "address": "node --import tsx server/src/cli.ts address",
    "data": "python scripts/build_data.py && python scripts/build_radicals.py && python scripts/build_fonts.py",
    "vercel-build": "tsc -b && vite build && node scripts/build-api.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "hono": "^4.13.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
